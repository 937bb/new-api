# Host port exposed by Docker.
PORT=3000

# App timezone.
TZ=Asia/Shanghai

# Existing PostgreSQL connection.
# The container uses host network mode, so 127.0.0.1 points to the server itself.
SQL_DSN=postgresql://global_newapi:CHANGE_ME_PG_PASSWORD@127.0.0.1:5432/global_newapi?sslmode=disable

# Existing Redis connection.
# If your Redis has a password, use: redis://:your_password@127.0.0.1:6379/5
REDIS_CONN_STRING=redis://127.0.0.1:6379/5

# Must be a long random string. Do not use random_string.
SESSION_SECRET=replace_with_a_long_random_secret

# Optional runtime flags.
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-node-1
