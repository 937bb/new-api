# ========================================
# new-api 自建 USDT / EPUSDT 配置示例
# ========================================
# 说明：EPUSDT 服务本身建议独立部署，new-api 只需要知道 EPUSDT 的公网地址、商户 PID 和 secret_key。
# 当前 EPUSDT / GM Pay 新接口需要先在 EPUSDT 后台创建商户 API Key，拿到 pid + secret_key。

# 是否启用 USDT 充值。也可以在后台：系统设置 -> 计费设置 -> 支付网关 -> USDT Gateway 中开启。
EPUSDT_ENABLED=true

# EPUSDT / GM Pay 服务公网地址，不要带结尾斜杠。
EPUSDT_URL=https://usdt.example.com

# EPUSDT 后台 API Key 行里的 pid。新装默认通常是 1000，请以 EPUSDT 后台为准。
EPUSDT_PID=1000

# EPUSDT 后台 API Key 行里的 secret_key。用于创建订单签名和回调验签。
# 生成示例：openssl rand -hex 32
EPUSDT_TOKEN=replace_with_merchant_secret_key

# 提交给 EPUSDT 的资产参数。TRC20 USDT 一般保持下面默认值。
EPUSDT_CURRENCY=usd
EPUSDT_TOKEN_SYMBOL=usdt
EPUSDT_NETWORK=tron

# 充值金额配置。
# EPUSDT_UNIT_PRICE 表示“用户选择的充值金额”创建 USDT 订单前的倍率；一般 1 USD ≈ 1 USDT，所以保持 1。
EPUSDT_UNIT_PRICE=1
EPUSDT_MIN_TOPUP=10
EPUSDT_MAX_TOPUP=10000

# 可选：Webhook / Return URL 覆盖。
# 不填时 Webhook 默认使用：<ServerAddress>/api/user/epusdt/notify
# Return URL 默认回到钱包页。
EPUSDT_NOTIFY_URL=
EPUSDT_RETURN_URL=

# 兼容非常旧的 EPUSDT 部署才开启；当前官方版本应保持 false，使用 GMPay 新接口。
EPUSDT_LEGACY_API=false
